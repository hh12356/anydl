# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
# 已经用 git rm -r --cached 停止跟踪了，这里再挡一道，
# 免得哪天 git add -A 又把它抓回仓库公开出去
.idea/

# Flet / Flet build outputs
build/

# PyInstaller 打包产物（dist 有 584MB，千万别提交）
dist/
*.spec
# 上面忽略掉所有 .spec，但打包配方要留下来：以后改完代码重建只需
# pyinstaller --noconfirm anydl.spec，不用重敲 --collect-all 那一长串。
# 注意 .gitignore 不支持行尾注释，注释只能单独占一行
!anydl.spec
anydl.exe

# Testing/Logs
*.log
spotdl_test.log
ytdlp_test.log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Project Binaries (Downloaded by Actions or for local testing)
bin/
